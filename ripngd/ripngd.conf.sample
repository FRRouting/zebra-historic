! -*- rip -*-
!
! RIPngd sample configuration file
!
! $Id: ripngd.conf.sample,v 1.12 1999/02/19 17:35:39 developer Exp $
!
hostname ripngd
password zebra
!
debug ripng event
debug ripng packet
!
router zebra
!
router ripng
! network sit1
! route 3ffe:506::0/32
!
! access-list local-only permit 3ffe:506::0/32
! access-list local-only deny any
!
! distribute-list local-only out sit1
log stdout
